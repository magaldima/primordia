{
  "name": "primordia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An evolutionary game of life where every creature is an LLM-driven agent.",
  "scripts": {
    "dev": "tsx watch --ignore 'src/**' server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/headless.ts",
    "analyze": "tsx scripts/analyze.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
